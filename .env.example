# Groq — the whole pipeline runs on Groq now: app/router.py for answer
# generation and app/classifier.py for intent classification. Each has its
# own model-ID var (classifier's kept separate from router's to avoid a
# circular import and to stay independently tunable — see classifier.py).
GROQ_API_KEY=gsk_...
GROQ_HAIKU_MODEL_ID=openai/gpt-oss-20b
GROQ_SONNET_MODEL_ID=openai/gpt-oss-120b
GROQ_CLASSIFIER_MODEL_ID=openai/gpt-oss-20b

# Redis (cache + quota gating)
REDIS_URL=redis://localhost:6379/0

# MongoDB (the transaction/budget mirror Copilot reads from — see
# app/data_access.py). The pipeline that populates this collection is
# backend-owned; Copilot only ever queries it by userToken. Load
# `moniger_copilot_fixtures_v2` locally for development (see CLAUDE.md).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=copilot_test
# Demo catalog only. Production requires a backend-reviewed merchant label catalog.
MERCHANT_LABELS_FILE=moniger_copilot_fixtures_v2/merchant_labels.json
# Index creation belongs to provisioning, not the read-only API role.
MONGODB_CREATE_INDEXES=false

# Auth — bearer JWT on the Authorization header, HS256, claims: sub=user_id,
# tier=free|premium|tester. free=5/mo and premium=50/mo are fixed in
# app/gating.py; `tester` is an internal tier for demo/evaluation runs only
# (never mint it for real users). Set it to 0 to disable the tier.
JWT_SECRET=dev-only-change-me
TESTER_MONTHLY_QUOTA=500

# Prompt context caps (estimated tokens). Groq's on-demand tier allows about
# 8,000 tokens per minute, so keep the defaults there; raise on a paid tier.
# HAIKU_CONTEXT_TOKEN_CAP=4000
# SONNET_CONTEXT_TOKEN_CAP=8000

# App
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# AWS Lambda (only used when deployed via handler.py)
AWS_REGION=eu-west-1

# Flask demo frontend (demo/flask_app.py)
# 4-digit numeric PIN for the login gate; the app refuses to start without it.
DEMO_PIN=1234
# Signs the Flask session cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
# FastAPI /ask endpoint the Flask app proxies to.
API_URL=http://localhost:8000/ask
# Default test persona until another is picked in the "Testing as" dropdown.
DEMO_USER_ID=usr_anon_i07sal
# Tier the demo signs requests with: tester (default) or premium.
# DEMO_JWT_TIER=tester
# Production behind HTTPS / a reverse proxy:
# FLASK_COOKIE_SECURE=true
# TRUST_PROXY=true
